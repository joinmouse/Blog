{
  "name": "blog-redesign",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "engineStrict": true,
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-manifest.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "prebuild": "node scripts/generate-manifest.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest": "node scripts/generate-manifest.mjs",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=joinmouse --branch=master --commit-dirty=true"
  },
  "dependencies": {
    "vue": "3.5.39",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@shikijs/markdown-it": "4.3.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.10.6",
    "markdown-it": "14.3.0",
    "markdown-it-anchor": "9.2.1",
    "shiki": "4.3.1",
    "typescript": "7.0.2",
    "unplugin-vue-markdown": "32.0.0",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7",
    "wrangler": "4.110.0"
  }
}
