{
  "name": "blog-redesign",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-search-index.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=joinmouse --branch=master --commit-dirty=true"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "vue": "^3.5.35",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@shikijs/markdown-it": "^4.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "playwright": "^1.60.0",
    "shiki": "^4.1.0",
    "typescript": "^5.5.4",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.2",
    "wrangler": "^4.95.0"
  }
}
