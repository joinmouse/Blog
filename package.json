{
  "name": "blog-redesign",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "engineStrict": true,
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-manifest.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "prebuild": "node scripts/generate-manifest.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest": "node scripts/generate-manifest.mjs",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=joinmouse --branch=master --commit-dirty=true"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@shikijs/markdown-it": "4.5.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.1",
    "markdown-it": "15.0.2",
    "markdown-it-anchor": "10.0.0",
    "shiki": "4.5.0",
    "typescript": "7.0.2",
    "unplugin-vue-markdown": "32.1.1",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13",
    "wrangler": "4.150.0"
  }
}
